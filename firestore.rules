rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Los casos solo son visibles para su propietario.
    // `list` exige el filtro userId en la consulta: sin él, Firestore la rechaza.
    match /cases/{documentId} {
      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow get: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /notary_profiles/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // El audit log lo escribe únicamente la Cloud Function `auditCaseChanges`
    // (Admin SDK, que no pasa por estas reglas). El cliente solo puede leer.
    match /audit_logs/{documentId} {
      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow get: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Cabeza de la cadena de hashes de cada caso. Solo la Function la escribe.
    match /audit_heads/{caseId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

  }
}
