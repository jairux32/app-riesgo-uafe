# jsdom declara `canvas` como peer opcional y npm 10 falla al resolverlo
# (error "Cannot read properties of null (reading 'edgesOut')").
# Se ignora la resolución estricta de peers para que `npm install`/`npm ci`
# sean reproducibles. Si se añade una dependencia con conflicto real de peers,
# revisarlo manualmente.
legacy-peer-deps=true
